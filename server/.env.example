# Copy this file to .env and fill in the values. Never commit .env.

# --- PostgreSQL on AWS RDS ---
DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=foodbridge
# the RDS master user (or any user with SELECT/INSERT/UPDATE on the 5 tables);
# fb_guest is read-only, so the POST/PATCH routes would fail with it
DB_USER=your-master-user
DB_PASSWORD=change-me
# RDS requires/encourages TLS; set to false only for a local database
DB_SSL=true

# --- API server ---
PORT=8080

# Snapshot time of the dataset. The API's clock starts here and runs forward
# in real time while the server is up, so time-based features (available
# donations, expiring food, recent demand) behave as if "now" were this moment.
AS_OF=2026-11-10 12:00:00
